# Copy to .env. Read by the API, Prisma and the dashboard (via next.config.ts).

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://workforce:workforce@localhost:5432/workforce

# Redis (matches docker-compose.yml). Nothing reads it yet; workers will.
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
# Browser origin allowed to call the API
DASHBOARD_ORIGIN=http://localhost:3000

# Dashboard -> API base URL (exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk authentication. Both the dashboard and the API read these two keys.
# Get them from https://dashboard.clerk.com (API keys), and enable Organizations there.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AI provider used by the agent runtime: "openrouter" (default) or "anthropic".
AI_PROVIDER=openrouter
# Optional: model id, reply cap in tokens, and how long one reply may take. The default model is
# "openrouter/auto" on OpenRouter (it chooses per request) and "claude-opus-5-5" on Anthropic.
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_MS=60000
# Embeddings for the knowledge base. Only "openrouter" exists so far. The model must produce
# 1536-dimension vectors (the default, openai/text-embedding-3-small, does).
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=
# Key for the provider in use: https://openrouter.ai/keys or https://platform.claude.com
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ---- Voice (phone calls) ----
# One phone provider or both. Each number is used through the account that owns it.
# Twilio: https://console.twilio.com (Account SID and Auth Token on the account dashboard).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Telnyx: https://portal.telnyx.com. API key under "API Keys"; TELNYX_APP_ID is the id of a TeXML
# Application (Voice > TeXML Applications; its URLs are filled in when a number is assigned).
# The account id is looked up from the API key when left empty.
TELNYX_API_KEY=
TELNYX_APP_ID=
TELNYX_ACCOUNT_SID=
# The https address the phone provider reaches this API at. In development, the ngrok URL for port 4000,
# e.g. https://abcd-1-2-3-4.ngrok-free.app (changes on each ngrok start unless you reserve a domain).
PUBLIC_URL=
# Speech to text: https://console.deepgram.com. Model defaults to nova-3.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
# Text to speech: https://elevenlabs.io/app/settings/api-keys. Voice defaults to the account's
# first default voice; model defaults to eleven_flash_v2_5.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# Only for `pnpm --filter @workforce/api try-call`: your Twilio or Telnyx number in +E.164 form, and
# optionally the employee's time zone and language.
VOICE_NUMBER=
VOICE_TIMEZONE=
VOICE_LANGUAGE=

# ---- Background jobs (Inngest) ----
# Leave all three empty and jobs run inside the API process (fine for development; a restart loses
# work in flight). Durable jobs locally: INNGEST_DEV=1 and `pnpm inngest:dev` (dashboard at
# http://localhost:8288). Production: the Event Key and Signing Key from app.inngest.com, and the app
# synced at PUBLIC_URL/api/inngest.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- WhatsApp ----
# Three providers; configure any of them. Each employee's WhatsApp number picks one on its
# Channels card, and that provider's webhook is PUBLIC_URL/channels/whatsapp/<meta|twilio|telnyx>/webhook.
# Twilio: uses TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above (a WhatsApp sender in that account).
# Telnyx: uses TELNYX_API_KEY above, plus the public key that signs its webhooks
# (Mission Control > Keys & Credentials > Public Key).
TELNYX_PUBLIC_KEY=
# Meta (Cloud API, direct): from your Meta app (developers.facebook.com > your app > WhatsApp > API
# Setup): a permanent System User access token with whatsapp_business_messaging, the app secret
# (App settings > Basic), and any verify token you choose (typed again in WhatsApp > Configuration
# with the callback URL). Graph API version defaults to v26.0.
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=
