generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// Tenant root. `id` is the Clerk organization id: Clerk owns the organization's profile,
// members and roles, and this row exists so tenant data has something to hang off.
model Organization {
  id         String      @id
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workspaces Workspace[]
  employees  AiEmployee[]
  conversations Conversation[]
  knowledgeSources KnowledgeSource[]
  customers  Customer[]
  toolExecutions ToolExecution[]
  calendarEvents CalendarEvent[]
  phoneNumbers   PhoneNumber[]
  calls          Call[]
  workflows      Workflow[]
  workflowExecutions WorkflowExecution[]
  employeeChannels   EmployeeChannel[]
  channelMessages    ChannelMessage[]
  evaluators         Evaluator[]
  evalDatasets       EvalDataset[]
  improvementSuggestions ImprovementSuggestion[]
  employeeRollouts   EmployeeRollout[]
  employeeReleases   EmployeeRelease[]
}

// A partition inside an organization (a brand, a team, an environment). Every organization has at least one.
model Workspace {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  employees      AiEmployee[]
  conversations  Conversation[]
  knowledgeSources KnowledgeSource[]
  customers      Customer[]
  workflows      Workflow[]

  @@unique([organizationId, name])
}

enum EmployeeStatus {
  DRAFT // never published
  ACTIVE
  PAUSED
  ARCHIVED
}

// Identity and operational state. All configuration lives in versions.
model AiEmployee {
  id             String         @id @default(cuid())
  // Denormalized from the workspace so every query can filter on the tenant directly.
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status         EmployeeStatus @default(DRAFT)

  // The version serving production. Editing never changes it; only publishing moves this pointer.
  publishedVersionId String?            @unique
  publishedVersion   AiEmployeeVersion? @relation("Published", fields: [publishedVersionId], references: [id])

  versions  AiEmployeeVersion[] @relation("Versions")
  conversations Conversation[]
  knowledgeSources EmployeeKnowledgeSource[]
  tools            ToolPermission[]
  phoneNumbers     PhoneNumber[]
  calls            Call[]
  channels         EmployeeChannel[]
  suggestions      ImprovementSuggestion[]
  rollouts         EmployeeRollout[]      @relation("Rollouts")
  // The rollout serving a share of customers a candidate version right now (at most one).
  activeRollout    EmployeeRollout?       @relation("ActiveRollout")
  releases         EmployeeRelease[]
  // The regression dataset versions of this employee are tested against before release.
  regressionSuite  EvalDataset?
  createdBy String // Clerk user id
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([organizationId, workspaceId, status])
  @@map("AIEmployee")
}

// Immutable snapshot of the configuration of an employee. Rows are only ever inserted.
model AiEmployeeVersion {
  id           String      @id @default(cuid())
  employeeId   String
  employee     AiEmployee  @relation("Versions", fields: [employeeId], references: [id], onDelete: Cascade)
  publishedFor AiEmployee? @relation("Published")
  number       Int // 1, 2, 3… per employee

  name               String
  description        String
  role               String
  personality        String
  systemInstructions String
  goals              String[]
  language           String
  avatar             String
  workingHours       Json
  escalation         Json

  evaluations Evaluation[]
  evalRuns    EvalRun[]
  suggestionsBased    ImprovementSuggestion[] @relation("SuggestionBase")
  proposedBy          ImprovementSuggestion?  @relation("SuggestionProposed")
  rolloutsAsControl   EmployeeRollout[]       @relation("RolloutControl")
  rolloutsAsCandidate EmployeeRollout[]       @relation("RolloutCandidate")
  createdBy String // Clerk user id
  createdAt DateTime @default(now())

  @@unique([employeeId, number])
  @@map("AIEmployeeVersion")
}

// One thread between a person and an AI employee. Every channel (test, voice, web_chat, whatsapp,
// email, workflow) stores its turns here through the agent runtime.
model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       AiEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  channel        String       @default("test")
  title          String // start of the first user message

  // Who answers the customer. The runtime replies only in AI_ACTIVE and REOPENED.
  status         ConversationStatus @default(AI_ACTIVE)
  // The human agent handling it (Clerk user id); null while it waits in the unassigned queue.
  assignedTo     String?
  // Consecutive turns that failed; reset by a reply. Reaching the employee's limit hands off.
  failedTurns    Int                @default(0)
  resolvedAt     DateTime?

  messages  ConversationMessage[]
  customer  CustomerConversation?
  calls     Call[]
  handoffs  Handoff[]
  suggestions CopilotSuggestion[]
  evaluations Evaluation[]
  createdBy String // Clerk user id, or "voice" for conversations started by a phone call
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([organizationId, workspaceId, employeeId, updatedAt])
  @@index([organizationId, workspaceId, status, updatedAt])
}

enum ConversationStatus {
  AI_ACTIVE
  WAITING_FOR_HUMAN // handed off; in the queue (assignedTo null) or assigned but not yet picked up
  HUMAN_ACTIVE // a person is answering; the AI stays silent until handed back
  RESOLVED
  REOPENED // resolved, then written to again (or reopened by an agent); the AI answers
}

enum MessageRole {
  USER
  ASSISTANT
  AGENT // a human agent, written from the inbox
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String

  // Set on assistant messages only: which configuration answered, and what it cost.
  employeeVersion Int?
  provider        String?
  model           String?
  inputTokens     Int?
  outputTokens    Int?
  latencyMs       Int?
  // Knowledge excerpts the reply was given: [{ documentId, documentName, sourceName, page }]
  sources         Json?
  // Tools called while writing the reply: [{ executionId, tool, status }]
  tools           Json?
  // AGENT messages: the Clerk user who wrote it.
  authorId        String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// A named collection of company documents in a workspace. Employees answer from the sources
// attached to them.
model KnowledgeSource {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String       @default("")

  documents KnowledgeDocument[]
  chunks    KnowledgeChunk[]
  employees EmployeeKnowledgeSource[]
  createdBy String // Clerk user id
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@unique([workspaceId, name])
  @@index([organizationId, workspaceId])
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model KnowledgeDocument {
  id             String          @id @default(cuid())
  // Tenant columns are repeated on documents and chunks so every query filters on them directly.
  organizationId String
  workspaceId    String
  sourceId       String
  source         KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  name           String
  kind           String // pdf | docx | txt | csv
  sizeBytes      Int
  // shortcut: the original file lives in Postgres so it can be reprocessed; move to object storage (R2) when wired
  content        Bytes
  status         DocumentStatus  @default(PENDING)
  error          String?
  chunkCount     Int             @default(0)

  chunks      KnowledgeChunk[]
  createdBy   String // Clerk user id
  createdAt   DateTime         @default(now())
  processedAt DateTime?

  @@index([organizationId, workspaceId, sourceId])
}

model KnowledgeChunk {
  id             String            @id
  organizationId String
  workspaceId    String
  sourceId       String
  source         KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  documentId     String
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index          Int // position in the document
  page           Int? // PDF page, when known
  content        String
  embedding      Embedding?

  @@unique([documentId, index])
  @@index([organizationId, workspaceId, sourceId])
}

// Kept apart from the chunk so text can be re-embedded with another model without re-chunking.
// Prisma cannot read or write the vector column; packages/knowledge uses SQL for it.
// shortcut: no vector index (exact search); add HNSW in SQL when a workspace nears 50k chunks
model Embedding {
  chunkId String                      @id
  chunk   KnowledgeChunk              @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  model   String
  vector  Unsupported("vector(1536)")
}

// Which sources an employee answers from. Not versioned: attaching takes effect immediately.
model EmployeeKnowledgeSource {
  employeeId String
  employee   AiEmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sourceId   String
  source     KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@id([employeeId, sourceId])
}

// A person AI employees talk to, identified by whatever the channel knows them by (email, phone,
// chat visitor id). Customers belong to a workspace, so every employee in it shares their memory.
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalId     String

  profile       CustomerProfile?
  memories      CustomerMemory[]
  conversations CustomerConversation[]
  createdAt     DateTime         @default(now())
  lastSeenAt    DateTime         @default(now())

  @@unique([workspaceId, externalId])
  @@index([organizationId, workspaceId, lastSeenAt])
}

// The customer's identity card, kept in step with their identity memories so a customer list
// needs no extra query.
model CustomerProfile {
  customerId String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String?
  email      String?
  phone      String?
  company    String?
  updatedAt  DateTime @updatedAt
}

// One remembered fact, extracted from conversations and validated before it is stored. A key
// holds one value: learning it again replaces it.
model CustomerMemory {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category       String // identity | preference | fact | lead | follow_up
  key            String // snake_case, e.g. budget
  value          String
  conversationId String? // where it was last learned
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([customerId, key])
}

// Which customer a conversation was with, and a running summary of it for later conversations.
model CustomerConversation {
  conversationId String       @id
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  summary        String       @default("")
  updatedAt      DateTime     @updatedAt

  @@index([customerId, updatedAt])
}

// A tool an employee may use, with the settings an admin chose. Not versioned: granting or
// revoking takes effect on the next tool call. `permissions` are the tool's permissions when it
// was granted; if a tool later needs more, old grants stop working until an admin grants again.
model ToolPermission {
  employeeId  String
  employee    AiEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tool        String
  config      Json
  permissions String[]
  grantedBy   String // Clerk user id
  createdAt   DateTime   @default(now())

  @@id([employeeId, tool])
}

enum ToolExecutionStatus {
  SUCCEEDED
  FAILED // ran (or tried to) and failed
  DENIED // not permitted: never ran
  INVALID // the model's input failed validation: never ran
}

// Audit log: one row per tool call the model made, whatever happened to it. Rows are only inserted.
model ToolExecution {
  id             String              @id // generated before the call; webhooks send it as the idempotency key
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  employeeId     String
  conversationId String? // may name a conversation that was never saved, if the turn failed afterwards
  customerId     String?
  tool           String
  status         ToolExecutionStatus
  input          Json // as the model wrote it
  output         Json?
  error          String?
  attempts       Int
  durationMs     Int
  createdAt      DateTime            @default(now())

  @@index([organizationId, workspaceId, createdAt])
  @@index([conversationId])
}

// The built-in calendar the booking tool writes to, one per workspace.
// shortcut: stands in for Google or Microsoft calendars; add a provider behind the tool when one is chosen
model CalendarEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  employeeId     String
  customerId     String?
  conversationId String?
  title          String
  startsAt       DateTime
  endsAt         DateTime
  timezone       String
  attendeeName   String?
  attendeeEmail  String?
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([workspaceId, startsAt])
}

// A phone number answered by an AI employee. Calls to it go to the employee's published version.
model PhoneNumber {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId      String
  employeeId       String
  employee         AiEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  number           String       @unique // E.164, e.g. +14155550100
  provider         String       @default("twilio")
  providerNumberId String // Twilio's PN... sid
  // What the employee says when it picks up. A template, since the model only speaks after the caller.
  greeting         String
  createdBy        String // Clerk user id
  createdAt        DateTime     @default(now())

  @@index([organizationId, workspaceId])
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  BUSY
  NO_ANSWER
  FAILED
  CANCELED
}

// One phone call with an AI employee. What was said is stored twice on purpose: as the
// conversation (through the agent runtime, like every channel) and as a timed transcript.
model Call {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId     String
  employeeId      String
  employee        AiEmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeVersion Int // the published version that took the call
  conversationId  String? // set after the first exchange is saved
  conversation    Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerId      String?
  direction       CallDirection
  status          CallStatus
  from            String
  to              String
  provider        String           @default("twilio")
  providerCallId  String?          @unique // Twilio CallSid
  streamId        String?
  greeting        String
  error           String?
  createdBy       String? // Clerk user id of whoever placed an outbound call
  // Set by workflow Voice Call steps (execution:node:attempt), so a step that runs again finds its call instead of dialing twice.
  idempotencyKey  String?          @unique
  createdAt       DateTime         @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSec     Int?

  participants CallParticipant[]
  transcript   CallTranscript[]
  transfers    CallTransfer[]

  @@index([organizationId, workspaceId, createdAt])
}

enum CallParticipantRole {
  CUSTOMER
  EMPLOYEE
}

model CallParticipant {
  id          String              @id @default(cuid())
  callId      String
  call        Call                @relation(fields: [callId], references: [id], onDelete: Cascade)
  role        CallParticipantRole
  phoneNumber String?
  customerId  String?
  employeeId  String?

  @@index([callId])
}

// What each side said, in order. Employee lines cut off by the caller are marked interrupted.
model CallTranscript {
  id          String              @id @default(cuid())
  callId      String
  call        Call                @relation(fields: [callId], references: [id], onDelete: Cascade)
  speaker     CallParticipantRole
  text        String
  offsetMs    Int // since the call was answered
  interrupted Boolean             @default(false)
  createdAt   DateTime            @default(now())

  @@index([callId, offsetMs])
}

enum WorkflowStatus {
  DRAFT // never published
  ACTIVE
  PAUSED // runs nothing: new runs are refused and running ones hold where they are
}

// A visual automation (the journey builder). Its steps live in versions; only publishing changes what runs.
model Workflow {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String         @default("")
  status         WorkflowStatus @default(DRAFT)
  // Secret part of the webhook trigger URL.
  hookToken      String
  // Set when deleted: hidden, never run, and its runs stopped. Cleared by restore.
  deletedAt      DateTime?

  publishedVersionId String?          @unique
  publishedVersion   WorkflowVersion? @relation("PublishedWorkflow", fields: [publishedVersionId], references: [id])

  versions   WorkflowVersion[]   @relation("WorkflowVersions")
  executions WorkflowExecution[]
  createdBy  String // Clerk user id
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([organizationId, workspaceId, updatedAt])
}

// Immutable snapshot of a workflow's graph. Rows are only ever inserted.
model WorkflowVersion {
  id           String    @id @default(cuid())
  workflowId   String
  workflow     Workflow  @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  publishedFor Workflow? @relation("PublishedWorkflow")
  number       Int // 1, 2, 3… per workflow
  // WorkflowDefinition (packages/shared/src/workflow.ts): nodes, their settings and the edges between them.
  definition   Json

  executions  WorkflowExecution[]
  evaluations Evaluation[]
  createdBy   String // Clerk user id
  createdAt   DateTime            @default(now())

  @@unique([workflowId, number])
}

enum WorkflowExecutionStatus {
  QUEUED // due at runAt
  RUNNING // claimed by a runner until lockedUntil
  WAITING // on a timer, a call or a person; due at runAt (null = until someone continues it)
  COMPLETED
  FAILED
}

// One run of a workflow version. The row is also the background job: runners claim due rows.
model WorkflowExecution {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  workflowId     String
  workflow       Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionId      String
  version        WorkflowVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade)
  status         WorkflowExecutionStatus @default(QUEUED)
  input          Json // what the trigger received
  // Outputs of finished steps by node id: what {{steps.<id>.<field>}} reads.
  context        Json                    @default("{}")
  currentNodeId  String? // the node to run (or being waited on); null once finished
  runAt          DateTime?               @default(now())
  lockedUntil    DateTime?
  error          String?
  startedBy      String // Clerk user id, or "webhook"
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  finishedAt     DateTime?

  steps WorkflowStepExecution[]

  @@index([status, runAt])
  @@index([organizationId, workspaceId, workflowId, createdAt])
}

enum WorkflowStepStatus {
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
}

// One attempt at one node. A retry adds a row with the next attempt number.
model WorkflowStepExecution {
  id          String             @id @default(cuid())
  executionId String
  execution   WorkflowExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String
  nodeType    String
  attempt     Int
  status      WorkflowStepStatus
  input       Json? // the node's settings with templates filled in
  output      Json?
  // What a waiting step remembers between checks (the call it placed, when its timer ends).
  state       Json?
  error       String?
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?

  @@index([executionId, startedAt])
}

// A messaging channel an AI employee answers on (web_chat, whatsapp, email). Voice uses PhoneNumber.
// Not versioned, like tools and knowledge: changes apply to the next message.
model EmployeeChannel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  employeeId     String
  employee       AiEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind           String // web_chat | whatsapp | email
  // What routes a message here: the widget key, Meta's phone number id, or the email address.
  address        String
  enabled        Boolean      @default(true)
  // channelConfigSchemas[kind] (packages/shared/src/channel.ts)
  config         Json
  // Tools usable on this channel; null = every tool the employee is granted.
  allowedTools   Json?
  // Web chat: signs visitor identities and session tokens. Email: part of the inbound webhook URL.
  secret         String
  createdBy      String // Clerk user id
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([kind, address])
  @@unique([employeeId, kind])
  @@index([organizationId, workspaceId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ChannelMessageStatus {
  RECEIVED // inbound, being answered
  HELD // inbound, kept for the human handling the conversation: the AI did not answer
  ANSWERED
  REJECTED // inbound, deliberately not answered: error says why
  PENDING // outbound, being sent
  SENT
  DELIVERED
  READ
  FAILED
}

// Audit log of every message in or out of a channel, with its delivery state. The conversation
// (ConversationMessage) holds what the employee saw; this holds what crossed the wire.
model ChannelMessage {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId       String
  employeeId        String
  channelId         String? // the EmployeeChannel; null for voice
  channel           String // web_chat | whatsapp | email | voice
  direction         MessageDirection
  status            ChannelMessageStatus
  customerId        String?
  conversationId    String?
  // The provider's id (WhatsApp wamid, email Message-ID): deduplicates retried webhooks, matches delivery receipts.
  providerMessageId String?
  from              String?
  to                String?
  text              String
  media             Json? // ChannelMedia[]
  // Inbound only: the normalized message (InboundMessage), read by the background job that answers it.
  payload           Json?
  error             String?
  attempts          Int                  @default(0)
  latencyMs         Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([channel, direction, providerMessageId])
  @@index([organizationId, workspaceId, createdAt])
  @@index([conversationId])
}

// One hand-over of a conversation from the AI to people, from the moment it was asked for until the
// conversation is resolved or handed back to the AI. The timestamps are the handoff analytics.
model Handoff {
  id              String       @id @default(cuid())
  organizationId  String
  workspaceId     String
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employeeId      String
  // HANDOFF_TRIGGERS (packages/shared/src/inbox.ts)
  trigger         String
  reason          String
  assignedTo      String? // Clerk user id
  requestedAt     DateTime     @default(now())
  acceptedAt      DateTime? // a person took it over
  firstResponseAt DateTime? // a person's first message
  endedAt         DateTime?
  outcome         String? // resolved | returned_to_ai

  @@index([organizationId, workspaceId, requestedAt])
  @@index([conversationId, endedAt])
}

// What the AI Copilot suggested to a human agent. Kept apart from the conversation's messages: a
// suggestion is never sent; the agent's own message records which suggestion it came from.
model CopilotSuggestion {
  id             String       @id @default(cuid())
  organizationId String
  workspaceId    String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedBy    String // Clerk user id
  reply          String
  summary        String
  nextAction     String
  // Customer facts shown with it: [{ key, value }]
  memory         Json
  // Knowledge passages it was given: [{ documentId, documentName, sourceName, page, excerpt }]
  citations      Json
  provider       String
  model          String
  inputTokens    Int
  outputTokens   Int
  latencyMs      Int
  // The AGENT message sent from it, if any, and whether the agent changed the text.
  usedInMessageId String?
  edited          Boolean?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

enum CallTransferStatus {
  INITIATED // the provider was asked to dial the person
  COMPLETED // the person answered and talked with the caller
  NO_ANSWER
  BUSY
  CANCELED // the caller hung up while it rang
  FAILED // the provider refused or could not dial
}

// Audit log of live call transfers to a person after a handoff, one row per attempt.
model CallTransfer {
  id             String             @id @default(cuid())
  organizationId String
  workspaceId    String
  callId         String
  call           Call               @relation(fields: [callId], references: [id], onDelete: Cascade)
  conversationId String?
  handoffId      String?
  to             String // E.164: the employee's escalation.transferNumber
  status         CallTransferStatus @default(INITIATED)
  error          String?
  talkSec        Int? // how long the person and the caller talked
  createdAt      DateTime           @default(now())
  endedAt        DateTime?

  @@index([callId])
  @@index([conversationId])
}

// ---- Quality control (Phase 11). Evaluation only observes: nothing here changes how employees answer. ----

// A grader definition. Its settings live in versions; saving appends one and makes it current, so every
// result records exactly which settings produced it. `enabled` is operational, not versioned.
model Evaluator {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  // The built-in evaluators every workspace starts with (correctness, grounding, ...); null for custom ones.
  key            String?
  enabled        Boolean      @default(true)

  currentVersionId String?           @unique
  currentVersion   EvaluatorVersion? @relation("CurrentEvaluator", fields: [currentVersionId], references: [id])

  versions  EvaluatorVersion[] @relation("EvaluatorVersions")
  results   EvaluationResult[]
  createdBy String // Clerk user id, or "system" for the built-in ones
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([workspaceId, key])
  @@index([organizationId, workspaceId])
}

// Immutable snapshot of an evaluator's settings. Rows are only ever inserted.
model EvaluatorVersion {
  id          String     @id @default(cuid())
  evaluatorId String
  evaluator   Evaluator  @relation("EvaluatorVersions", fields: [evaluatorId], references: [id], onDelete: Cascade)
  currentFor  Evaluator? @relation("CurrentEvaluator")
  number      Int
  name        String
  description String
  dimension   String // EVAL_DIMENSIONS
  kind        String // deterministic | llm | rule
  config      Json // evaluatorConfigSchemas[kind]
  passScore   Int

  results   EvaluationResult[]
  createdBy String
  createdAt DateTime           @default(now())

  @@unique([evaluatorId, number])
}

enum EvaluationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// One grading of a conversation as it stood at `lastMessageAt`, with what produced it: the employee
// version and model of its replies, and the workflow version that started it, if any.
model Evaluation {
  id                String             @id @default(cuid())
  organizationId    String
  workspaceId       String
  conversationId    String
  conversation      Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employeeId        String
  employeeVersionId String?
  employeeVersion   AiEmployeeVersion? @relation(fields: [employeeVersionId], references: [id], onDelete: SetNull)
  provider          String?
  model             String?
  workflowVersionId String?
  workflowVersion   WorkflowVersion?   @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)
  trigger           String // auto | manual | dataset
  // Automatic evaluations: conversation id + last message time, so two sweeps never grade the same state twice.
  autoKey           String?            @unique
  datasetRunId      String?
  datasetRun        EvalRun?           @relation(fields: [datasetRunId], references: [id], onDelete: Cascade)
  caseId            String?
  status            EvaluationStatus   @default(PENDING)
  score             Float? // average of the scored results, 0-100
  passed            Boolean?
  failures          Int                @default(0)
  messageCount      Int
  lastMessageAt     DateTime
  error             String?
  requestedBy       String // Clerk user id, or "system"
  createdAt         DateTime           @default(now())
  completedAt       DateTime?

  results EvaluationResult[]

  @@index([organizationId, workspaceId, createdAt])
  @@index([conversationId, createdAt])
  @@index([datasetRunId])
}

// What one evaluator version said about one evaluation.
model EvaluationResult {
  id                 String           @id @default(cuid())
  evaluationId       String
  evaluation         Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evaluatorId        String
  evaluator          Evaluator        @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  evaluatorVersionId String
  evaluatorVersion   EvaluatorVersion @relation(fields: [evaluatorVersionId], references: [id], onDelete: Cascade)
  dimension          String
  kind               String
  status             String // scored | skipped | error
  score              Int? // 0-100
  passed             Boolean?
  reason             String
  // { findings: [{ message, quote? }], usage?: { provider, model, inputTokens, outputTokens } }
  details            Json
  createdAt          DateTime         @default(now())

  @@index([evaluationId])
  @@index([evaluatorId, createdAt])
}

// A regression test set: conversations copied from production or written by hand, replayed against an
// employee version and graded by the workspace's evaluators.
model EvalDataset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  name           String
  description    String       @default("")
  // Set on an employee's regression suite: changes to that employee are tested on these cases before release.
  employeeId     String?      @unique
  employee       AiEmployee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  cases     EvalCase[]
  runs      EvalRun[]
  createdBy String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([workspaceId, name])
}

model EvalCase {
  id             String      @id @default(cuid())
  datasetId      String
  dataset        EvalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name           String
  source         String // conversation | synthetic
  // The conversation it was copied from; the copy stays if that conversation goes.
  conversationId String?
  // [{ role: customer | employee, content }]; replays send the customer's messages in order.
  messages       Json
  expectations   String      @default("")
  createdAt      DateTime    @default(now())

  @@index([datasetId])
}

// One replay of a dataset against an employee version.
model EvalRun {
  id                String            @id @default(cuid())
  organizationId    String
  workspaceId       String
  datasetId         String
  dataset           EvalDataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  employeeId        String
  employeeVersionId String
  employeeVersion   AiEmployeeVersion @relation(fields: [employeeVersionId], references: [id], onDelete: Cascade)
  status            EvaluationStatus  @default(PENDING)
  score             Float?
  total             Int
  passed            Int               @default(0)
  failed            Int               @default(0)
  error             String?
  startedBy         String
  createdAt         DateTime          @default(now())
  completedAt       DateTime?

  evaluations Evaluation[]
  baselineFor  ImprovementSuggestion? @relation("SuggestionBaseline")
  candidateFor ImprovementSuggestion? @relation("SuggestionCandidate")

  @@index([datasetId, createdAt])
}

// ---- Continuous improvement (Phase 12) ----

// A change proposed for an employee from a pattern of evaluation failures on one version. It never changes
// production by itself: a person creates the version and tests it, a person approves, a person rolls it out.
model ImprovementSuggestion {
  id                String                @id @default(cuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId       String
  employeeId        String
  employee          AiEmployee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // The version the failures happened on; the proposed version is this one with the change applied.
  baseVersionId     String
  baseVersion       AiEmployeeVersion     @relation("SuggestionBase", fields: [baseVersionId], references: [id], onDelete: Cascade)
  // The pattern: the evaluator that kept failing, and its dimension.
  evaluatorId       String
  dimension         String
  title             String
  reason            String
  // { failures, results, examples: [{ evaluationId, conversationId, reason, findings: [{ message, quote? }] }] }
  evidence          Json
  // { summary, fields: { systemInstructions?, personality?, goals? } }: the new values of the changed fields.
  change            Json
  // The KPI the change should move: score | pass_rate | an evaluation dimension.
  kpi               String
  proposedVersionId String?               @unique
  proposedVersion   AiEmployeeVersion?    @relation("SuggestionProposed", fields: [proposedVersionId], references: [id], onDelete: SetNull)
  // Regression suite runs: the base version and the proposed one, on the same cases.
  baselineRunId     String?               @unique
  baselineRun       EvalRun?              @relation("SuggestionBaseline", fields: [baselineRunId], references: [id], onDelete: SetNull)
  candidateRunId    String?               @unique
  candidateRun      EvalRun?              @relation("SuggestionCandidate", fields: [candidateRunId], references: [id], onDelete: SetNull)
  approval          String                @default("pending") // pending | approved | rejected
  decidedBy         String?
  decidedAt         DateTime?
  decisionNote      String                @default("")
  rollouts          EmployeeRollout[]
  createdBy         String // "system" (the analysis job) or a Clerk user id
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // One suggestion per failure pattern: a version and an evaluator.
  @@unique([baseVersionId, evaluatorId])
  @@index([organizationId, workspaceId, createdAt])
}

// A candidate version served to a share of customers next to the published one (A/B), until a person
// promotes it (publishes it) or rolls it back.
model EmployeeRollout {
  id                 String                 @id @default(cuid())
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId        String
  employeeId         String
  employee           AiEmployee             @relation("Rollouts", fields: [employeeId], references: [id], onDelete: Cascade)
  // Set while active (the unique index allows one active rollout per employee); null once it ends.
  activeEmployeeId   String?                @unique
  activeFor          AiEmployee?            @relation("ActiveRollout", fields: [activeEmployeeId], references: [id], onDelete: Cascade)
  controlVersionId   String
  controlVersion     AiEmployeeVersion      @relation("RolloutControl", fields: [controlVersionId], references: [id], onDelete: Cascade)
  candidateVersionId String
  candidateVersion   AiEmployeeVersion      @relation("RolloutCandidate", fields: [candidateVersionId], references: [id], onDelete: Cascade)
  suggestionId       String?
  suggestion         ImprovementSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  // Share of customers (1-100) served the candidate; a customer keeps their side while it does not shrink.
  percent            Int
  status             String // active | promoted | rolled_back
  kpi                String
  startedBy          String
  startedAt          DateTime               @default(now())
  endedBy            String?
  endedAt            DateTime?

  @@index([employeeId, startedAt])
}

// Every change of the live version: publish, rollback, a promoted rollout. Read for "roll back to the previous version".
model EmployeeRelease {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId     String
  employeeId      String
  employee        AiEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  action          String // publish | rollback | promote
  version         Int
  previousVersion Int?
  rolloutId       String?
  by              String
  createdAt       DateTime     @default(now())

  @@index([employeeId, createdAt])
}
